# OpenSearch holding the jobs alias (the local compose stack publishes 9200)
OPENSEARCH_URL=http://localhost:9200
JOBS_INDEX=jobs
# Optional: the crawler's Postgres, for crawl health on the internal /admin page
DATABASE_URL=postgres://jbi:jbi@localhost:55432/jbi
# Optional: turns /admin on (at least 12 characters). On AWS it comes from Secrets Manager.
ADMIN_PASSWORD=change-me-local-only
